  "keyFeatures": [
    "End-to-end recruitment pipeline management",
    "Job posting creation and multi-channel distribution",
    "Candidate sourcing, tracking, and profile management",
    "Configurable hiring stages and custom pipeline workflows",
    "Interview scheduling with calendar integration",
    "Offer letter generation and e-signature collection",
    "Role-based access control (Admin, Recruiter, Hiring Manager, Interviewer)",
    "Analytics dashboard with funnel reporting and source tracking",
    "Email template library with automated candidate communications",
    "REST API and webhook support for third-party integrations",
    "Document management for resumes, portfolios, and assessments",
    "Versioned release history for compliance and audit trails"
  ],
  "publicApiSurface": [
    "GET /api/v1/jobs — List all open positions",
    "POST /api/v1/jobs — Create a new job posting",
    "GET /api/v1/jobs/{id} — Retrieve job details",
    "PUT /api/v1/jobs/{id} — Update a job posting",
    "DELETE /api/v1/jobs/{id} — Archive a job posting",
    "GET /api/v1/candidates — List candidates",
    "POST /api/v1/candidates — Add a new candidate",
    "GET /api/v1/candidates/{id} — Get candidate profile",
    "PUT /api/v1/candidates/{id} — Update candidate profile",
    "GET /api/v1/applications — List applications",
    "POST /api/v1/applications — Submit a new application",
    "PATCH /api/v1/applications/{id}/status — Update application stage",
    "GET /api/v1/interviews — List scheduled interviews",
    "POST /api/v1/interviews — Schedule an interview",
    "DELETE /api/v1/interviews/{id} — Cancel an interview",
    "POST /api/v1/webhooks — Register a webhook endpoint",
    "GET /api/v1/reports/funnel — Candidate funnel report",
    "GET /api/v1/reports/sources — Source effectiveness report"
  ]
}
